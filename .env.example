# Base PostgreSQL avec extension pgvector
RAG_DATABASE_URL=postgresql://user:password@host:5432/fikra

# Fournisseur OpenAI-compatible, utilisé uniquement côté serveur
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_me
AI_CHAT_MODEL=replace_with_chat_model
AI_EMBEDDING_MODEL=replace_with_embedding_model

# Paramètres RAG optionnels
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.50
MAX_UPLOAD_MB=20

# Authentification : connexion Supabase réelle
FIKRA_COOKIE_SECURE=true

# Supabase Auth — utilisés uniquement côté serveur
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
